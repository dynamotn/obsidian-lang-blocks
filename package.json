{
  "name": "obsidian-lang-blocks",
  "version": "0.1.0",
  "private": true,
  "description": "Show one language at a time in Obsidian reading mode for notes written with <!--lang:xx--> blocks",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=cjs --platform=browser --target=es2022 --external:obsidian --external:@codemirror/state --external:@codemirror/view --outfile=main.js",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/bun": "^1.4.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "6"
  }
}
